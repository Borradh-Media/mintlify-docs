{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Borradh Help Centre",
  "description": "Guides and support for Borradh \u2014 setup, your connected channels, and how the product works.",
  "colors": {
    "primary": "#1447E6",
    "light": "#6E9FFF",
    "dark": "#0F38B8"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Help Centre",
        "groups": [
          {
            "group": "Onboarding",
            "pages": [
              "onboarding/assign-access"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "Get support",
        "href": "mailto:support@borradh.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.borradh.io"
    }
  },
  "fonts": {
    "family": "Inter",
    "weight": 400,
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "appearance": {
    "default": "system"
  },
  "footer": {
    "socials": {
      "website": "https://www.borradh.io"
    },
    "links": [
      {
        "header": "Borradh",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.borradh.io"
          },
          {
            "label": "Contact support",
            "href": "mailto:support@borradh.io"
          }
        ]
      }
    ]
  }
}
